<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- versão do Windows 10 necessária para os controles de mídia (Windows.Media.Control) -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <!-- No Debug roda via "dotnet SoundTuneKey.dll" (assinado pela Microsoft): o Smart App Control
         do Windows 11 bloqueia o .exe local sem assinatura. O Release continua gerando o .exe. -->
    <UseAppHost Condition="'$(Configuration)' == 'Debug'">false</UseAppHost>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- desenha nítido em cada monitor, mesmo com escalas diferentes (100% num, 125% no outro) -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>..\..\assets\icon\icon.ico</ApplicationIcon>

    <!-- aparece nas Propriedades do .exe e nos avisos de segurança do Windows -->
    <Version>0.6.4</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Sound Tune Key</Product>
    <AssemblyTitle>Sound Tune Key</AssemblyTitle>
    <Authors>ppdrada</Authors>
    <Copyright>© 2026 ppdrada</Copyright>
  </PropertyGroup>

  <!-- dotnet publish -c Release: um único .exe que roda sem instalar o .NET -->
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="3.3.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\icon\icon.ico" LogicalName="SoundTuneKey.icon.ico" />
  </ItemGroup>

</Project>